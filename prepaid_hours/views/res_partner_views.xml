<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_prepaid_form" model="ir.ui.view">
        <field name="name">res.partner.prepaid.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_view_prepaid_balances"
                        class="oe_stat_button"
                        icon="fa-clock-o">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Prepaid Balances</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
