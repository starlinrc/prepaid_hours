<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón stat en sale.order -->
    <record id="view_sale_order_prepaid_form" model="ir.ui.view">
        <field name="name">sale.order.prepaid.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_prepaid_balances"
                        type="object" class="oe_stat_button"
                        icon="fa-clock-o"
                        invisible="prepaid_balance_count == 0">
                    <field name="prepaid_balance_count" widget="statinfo"
                           string="Prepaid Balances"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
