<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Alerta: saldo bajo -->
    <record id="mail_template_low_balance" model="mail.template">
        <field name="name">Prepaid Balance: Low Balance Alert</field>
        <field name="model_id" ref="prepaid_hours.model_prepaid_balance"/>
        <field name="subject">⚠️ Low prepaid balance: {{ object.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <p>Dear <t t-out="object.partner_id.name"/>,</p>
            <p>
                Your prepaid balance <strong><t t-out="object.name"/></strong>
                for package <strong><t t-out="object.product_id.name"/></strong>
                is running low.
            </p>
            <table style="border-collapse:collapse; width:400px;">
                <tr>
                    <td style="padding:8px; border:1px solid #ddd;"><strong>Total purchased</strong></td>
                    <td style="padding:8px; border:1px solid #ddd;"><t t-out="object.qty_total"/> <t t-out="object.prepaid_unit"/></td>
                </tr>
                <tr>
                    <td style="padding:8px; border:1px solid #ddd;"><strong>Consumed</strong></td>
                    <td style="padding:8px; border:1px solid #ddd;"><t t-out="object.qty_consumed"/> <t t-out="object.prepaid_unit"/></td>
                </tr>
                <tr style="background:#fff3cd;">
                    <td style="padding:8px; border:1px solid #ddd;"><strong>Remaining</strong></td>
                    <td style="padding:8px; border:1px solid #ddd;"><t t-out="object.qty_remaining"/> <t t-out="object.prepaid_unit"/></td>
                </tr>
            </table>
            <p>Please contact us to renew your package.</p>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Alerta: saldo agotado -->
    <record id="mail_template_exhausted" model="mail.template">
        <field name="name">Prepaid Balance: Exhausted</field>
        <field name="model_id" ref="prepaid_hours.model_prepaid_balance"/>
        <field name="subject">🔴 Prepaid balance exhausted: {{ object.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <p>Dear <t t-out="object.partner_id.name"/>,</p>
            <p>
                Your prepaid balance <strong><t t-out="object.name"/></strong>
                has been fully consumed.
            </p>
            <p>Please contact us to purchase a new package and continue receiving our services.</p>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
