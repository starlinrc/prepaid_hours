<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_prepaid_check_expiry" model="ir.cron">
        <field name="name">Prepaid Hours: Check Balance Expiry</field>
        <field name="model_id" ref="prepaid_hours.model_prepaid_balance"/>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="seq_prepaid_balance" model="ir.sequence">
        <field name="name">Prepaid Balance</field>
        <field name="code">prepaid.balance</field>
        <field name="prefix">PB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
